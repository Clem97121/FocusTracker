<Window x:Class="FocusTracker.App.Views.JarvisPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Джарвіс"
        Width="420"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False">

    <Border Background="{StaticResource AccentBrush}"
            BorderBrush="{StaticResource SecondAccentBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Foreground="Gray" FontSize="12" Margin="0 0 0 6"/>
            <TextBlock x:Name="MessageText" Foreground="White" FontSize="14" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 12 0 0">
                <Button Content="Відповісти"
                        Width="110" Height="28"
                        Margin="0 0 8 0"
                        Click="Reply_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button Content="Ок"
                        Width="80" Height="28"
                        Click="Ok_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
