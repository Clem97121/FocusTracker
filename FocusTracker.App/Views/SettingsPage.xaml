<UserControl x:Class="FocusTracker.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">

            <TextBlock Text="Простій"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 10"/>

            <TextBlock Foreground="Gray" FontSize="13" TextWrapping="Wrap" Margin="0 0 0 15"
                       Text="Якщо стільки хвилин немає введення з миші чи клавіатури, програма у фокусі не відтворює звук і не розгорнута на весь екран, час перестає рахуватись. Для окремих програм простій можна вимкнути на сторінці «Застосунки»."/>

            <StackPanel Orientation="Horizontal">
                <Slider x:Name="IdleSlider"
                        Minimum="1" Maximum="60"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Width="300"
                        Style="{StaticResource SliderStyle}"
                        ValueChanged="IdleSlider_ValueChanged"/>
                <TextBlock x:Name="IdleValueText"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="Зберегти"
                        Width="150" Height="30"
                        Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <TextBlock x:Name="SavedText"
                           Text="Збережено"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
