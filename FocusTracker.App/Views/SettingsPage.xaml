<UserControl x:Class="FocusTracker.App.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20" MaxWidth="600" HorizontalAlignment="Left">

            <TextBlock Text="Простій"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 0 0 10"/>

            <TextBlock Foreground="Gray" FontSize="13" TextWrapping="Wrap" Margin="0 0 0 15"
                       Text="Якщо стільки хвилин немає введення з миші чи клавіатури, програма у фокусі не відтворює звук і не розгорнута на весь екран, час перестає рахуватись. Для окремих програм простій можна вимкнути на сторінці «Застосунки»."/>

            <StackPanel Orientation="Horizontal">
                <Slider x:Name="IdleSlider"
                        Minimum="1" Maximum="60"
                        IsSnapToTickEnabled="True" TickFrequency="1"
                        Width="300"
                        Style="{StaticResource SliderStyle}"
                        ValueChanged="IdleSlider_ValueChanged"/>
                <TextBlock x:Name="IdleValueText"
                           Foreground="White"
                           FontSize="14"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0 20 0 0">
                <Button Content="Зберегти"
                        Width="150" Height="30"
                        Click="Save_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <TextBlock x:Name="SavedText"
                           Text="Збережено"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"
                           Visibility="Collapsed"/>
            </StackPanel>

            <TextBlock Text="Синхронізація між пристроями"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 40 0 10"/>

            <TextBlock Foreground="Gray" FontSize="13" TextWrapping="Wrap" Margin="0 0 0 15"
                       Text="Статистика всіх пристроїв збирається в спільній базі Supabase. Ліміти рахуються за сумою пристроїв. Рядок підключення: Supabase → Connect → Session pooler (формат .NET). Він зберігається зашифрованим лише на цьому комп'ютері."/>

            <TextBlock Text="Назва цього пристрою" Foreground="White" Margin="0 0 0 5"/>
            <TextBox x:Name="DeviceNameBox" Style="{StaticResource TextBoxStyle}" Margin="0 0 0 10"/>

            <TextBlock Text="Рядок підключення" Foreground="White" Margin="0 0 0 5"/>
            <PasswordBox x:Name="ConnectionBox"
                         Height="30"
                         Padding="5 0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource AccentBrush}"
                         Foreground="White"
                         BorderBrush="{StaticResource SecondAccentBrush}"
                         Margin="0 0 0 5"/>
            <TextBlock x:Name="ConnectionHint" Foreground="Gray" FontSize="12" Margin="0 0 0 10"/>

            <CheckBox x:Name="SyncEnabledBox"
                      Content="Синхронізувати"
                      Style="{StaticResource LeftAlignedCheckBox}"
                      Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="SaveSyncButton"
                        Content="Зберегти"
                        Width="150" Height="30"
                        Click="SaveSync_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="TestConnectionButton"
                        Content="Перевірити підключення"
                        Width="200" Height="30"
                        Margin="10 0 0 0"
                        Click="TestConnection_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <TextBlock x:Name="SyncStatusText"
                       Foreground="Gray"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0 10 0 0"/>

            <TextBlock x:Name="AssistantHeader"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 40 0 10"/>

            <TextBlock Foreground="Gray" FontSize="13" TextWrapping="Wrap" Margin="0 0 0 15"
                       Text="Асистент продуктивності на базі Claude. У продуктивні години раз на кілька хвилин дивиться, що ви робите (програми й заголовки вікон за останню годину, статистика всіх пристроїв, задачі), порівнює з цілями й за потреби нагадує, пропонує план або вмикає фокус-режим. Ці дані надсилаються в Anthropic; заголовки вікон зберігаються лише в режимі «Мозок у хмарі» — у вашій базі Supabase, 3 години."/>

            <CheckBox x:Name="JarvisEnabledBox"
                      Content="Увімкнути асистента"
                      Style="{StaticResource LeftAlignedCheckBox}"
                      Margin="0 0 0 10"/>

            <TextBlock Text="Ключ Anthropic API (console.anthropic.com → API Keys)" Foreground="White" Margin="0 0 0 5"/>
            <PasswordBox x:Name="AnthropicKeyBox"
                         Height="30"
                         Padding="5 0"
                         VerticalContentAlignment="Center"
                         Background="{StaticResource AccentBrush}"
                         Foreground="White"
                         BorderBrush="{StaticResource SecondAccentBrush}"
                         Margin="0 0 0 5"/>
            <TextBlock x:Name="AnthropicKeyHint" Foreground="Gray" FontSize="12" Margin="0 0 0 10"/>

            <TextBlock Text="Модель" Foreground="White" Margin="0 0 0 5"/>
            <ComboBox x:Name="JarvisModelBox"
                      Width="300"
                      HorizontalAlignment="Left"
                      SelectedValuePath="Tag"
                      Style="{StaticResource CustomComboBox}"
                      Margin="0 0 0 10">
                <ComboBoxItem Content="Claude Opus 5.5 — найрозумніша" Tag="claude-opus-5-5"/>
                <ComboBoxItem Content="Claude Sonnet 5.5 — швидша й дешевша" Tag="claude-sonnet-5-5"/>
                <ComboBoxItem Content="Claude Haiku 5.5 — найдешевша" Tag="claude-haiku-5-5"/>
            </ComboBox>

            <TextBlock Text="Мої цілі (за пріоритетом, своїми словами)" Foreground="White" Margin="0 0 0 5"/>
            <TextBox x:Name="GoalsBox"
                     Style="{StaticResource TextBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="110"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 0 0 10"/>

            <TextBlock Text="Правила для асистента (необов'язково)" Foreground="White" Margin="0 0 0 5"/>
            <TextBox x:Name="RulesBox"
                     Style="{StaticResource TextBoxStyle}"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Height="80"
                     VerticalContentAlignment="Top"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <TextBlock Text="Продуктивні години з" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="FromHourBox" Width="50" Margin="8 0" Style="{StaticResource TextBoxStyle}"/>
                <TextBlock Text="до" Foreground="White" VerticalAlignment="Center"/>
                <TextBox x:Name="ToHourBox" Width="50" Margin="8 0" Style="{StaticResource TextBoxStyle}"/>
                <TextBlock Text="перевіряти кожні" Foreground="White" VerticalAlignment="Center" Margin="10 0 0 0"/>
                <TextBox x:Name="CheckMinutesBox" Width="50" Margin="8 0" Style="{StaticResource TextBoxStyle}"/>
                <TextBlock Text="хв" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>

            <CheckBox x:Name="MayFocusBox"
                      Content="Дозволити асистенту самому вмикати фокус-режим (закриває відволікаючі програми)"
                      Style="{StaticResource LeftAlignedCheckBox}"
                      Margin="0 0 0 10"/>

            <CheckBox x:Name="AssistantInCloudBox"
                      Content="Мозок у хмарі (Supabase)"
                      Style="{StaticResource LeftAlignedCheckBox}"
                      Margin="0 0 0 5"/>
            <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap" Margin="0 0 0 10"
                       Text="Перевірки й чат виконує функція Supabase, тож асистент спільний для всіх пристроїв і працює, навіть коли цей комп'ютер вимкнено. Потрібна синхронізація вище. Один раз: розгорніть функцію assistant (supabase/README.md), задайте ANTHROPIC_API_KEY у Supabase → Edge Functions → Secrets і натисніть «Налаштувати хмару». Ключ Anthropic API вище тоді не потрібен."/>

            <StackPanel Orientation="Horizontal" Margin="0 0 0 10">
                <Button x:Name="SetupCloudButton"
                        Content="Налаштувати хмару"
                        Width="200" Height="30"
                        Click="SetupCloud_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>
            <TextBlock x:Name="CloudSetupStatusText"
                       Foreground="Gray"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal">
                <Button Content="Зберегти"
                        Width="150" Height="30"
                        Click="SaveJarvis_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <TextBlock x:Name="JarvisStatusText"
                           Foreground="Gray"
                           VerticalAlignment="Center"
                           Margin="15 0 0 0"/>
            </StackPanel>

            <TextBlock Text="Оновлення"
                       FontSize="18"
                       FontWeight="Bold"
                       Foreground="White"
                       Margin="0 40 0 10"/>

            <TextBlock x:Name="VersionText" Foreground="White" FontSize="14" Margin="0 0 0 10"/>

            <StackPanel Orientation="Horizontal">
                <Button x:Name="CheckUpdatesButton"
                        Content="Перевірити оновлення"
                        Width="200" Height="30"
                        Click="CheckUpdates_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
                <Button x:Name="InstallUpdateButton"
                        Content="Оновити"
                        Width="120" Height="30"
                        Margin="10 0 0 0"
                        Visibility="Collapsed"
                        Click="InstallUpdate_Click"
                        Style="{StaticResource AccentButtonStyle}"/>
            </StackPanel>

            <TextBlock x:Name="UpdateStatusText"
                       Foreground="Gray"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Margin="0 10 0 0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
